@inherits LayoutComponentBase
@inject NavigationManager navMan

<div class="table table-fixed w-full bg-slate-100">
    <div class="table-row-group">
        <div class="table-row">
            <div class="table-cell border-b-3 border-slate-200" />
            <div class="table-cell w-8/10 border-b-3 border-r-3 border-l-3 border-slate-200">
                <div class="inline-grid grid-cols-2 gap-4">
                    <div class="flex items-center justify-center font-semibold text-3xl">
                        <span>Dynamic Tree Searcher</span>
                    </div>
                    <div class="flex flex-row items-center justify-center gap-7 h-30">
                        <NavLink class="@GetInactiveClass()" href="/Items"
                                 ActiveClass="@GetActiveClass()">
                            Item overview
                        </NavLink>
                        <NavLink href="/AddItems"
                                 class="@GetInactiveClass()"
                                 ActiveClass="@GetActiveClass()">
                            Add new item
                        </NavLink>
                        <div class="@GetInactiveClass()">
                            Navigation bar
                        </div>
                        <div class="@GetInactiveClass()">
                            Navigation bar
                        </div>
                    </div>
                </div>
            </div>
            <div class="table-cell border-b-3 border-slate-200" />
        </div>
        <div class="table-row">
            <div class="table-cell border-b-3 border-slate-200" />
            <div class="table-cell border-b-3 border-r-3 border-l-3 border-slate-200">
                @Body
            </div>
            <div class="table-cell border-b-3 border-slate-200" />
        </div>
        <div class="table-row">
            <div class="table-cell border-b-3 border-slate-200" />
            <div class="table-cell border-b-3 border-r-3 border-l-3 border-slate-200">
                <div class="inline-grid grid-cols-2 gap-4">
                    <div class="flex items-center justify-center font-semibold text-3xl">
                        <span>Contact me</span>
                    </div>
                    <div class="flex flex-row items-center justify-center gap-7 h-30">
                        <a class="@GetInactiveClass()" href="mailto:danielhoppe123@gmail.com">
                            Email
                        </a>
                        <a href="https://github.com/cvHanky"
                                 class="@GetInactiveClass()">
                            GitHub
                        </a>
                        <a href="https://www.linkedin.com/in/daniel-hoppe-hansen-1a152a222/"
                            class="@GetInactiveClass()">
                            LinkedIn
                        </a>
                    </div>
                </div>
            </div>
            <div class="table-cell border-b-3 border-slate-200" />
        </div>
    </div>
</div>



@code {
    private string GetInactiveClass()
    {
        return "p-3 font-semibold transition-all duration-500 ease-in-out hover:cursor-pointer hover:bg-slate-300 hover:rounded-lg hover:shadow-sm";
    }

    private string GetActiveClass()
    {
        return "bg-slate-200 rounded-lg shadow-sm";
    }
}