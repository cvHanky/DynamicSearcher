@inherits LayoutComponentBase
@inject NavigationManager navMan

<div class="flex flex-col items-center justify-center mx-15 mt-2 bg-slate-100">
    <div class="flex items-center justify-center w-full border border-3 border-slate-300 gap-10 h-40">
        <NavLink class="@GetInactiveClass()" href="/Items"
                 ActiveClass="@GetActiveClass()">
            Item overview
        </NavLink>
        <NavLink href="/AddItems"
                 class="@GetInactiveClass()"
                 ActiveClass="@GetActiveClass()">
            Add new item
        </NavLink>
        <div class="@GetInactiveClass()">
            Navigation bar
        </div>
        <div class="@GetInactiveClass()">
            Navigation bar
        </div>
    </div>
    @Body
</div>

@code {
    private string GetInactiveClass()
    {
        return "p-3 font-semibold transition-all duration-500 ease-in-out hover:cursor-pointer hover:bg-slate-300 hover:rounded-lg hover:shadow-sm";
    }

    private string GetActiveClass()
    {
        return "bg-slate-300 rounded-lg shadow-lg hover:bg-slate-400";
    }
}