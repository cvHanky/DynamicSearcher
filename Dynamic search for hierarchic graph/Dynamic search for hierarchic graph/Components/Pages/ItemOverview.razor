@page "/Items"
@using Dynamic_search_for_hierarchic_graph.Components.Reusables
@inject GraphItemRepository ItemRepo
@rendermode InteractiveServer

<PageTitle>Item Overview</PageTitle>

@if (isLoading)
{
}
else
{
    <div class="flex flex-col p-20">
        @foreach (var item in items)
        {
            <GraphItemComponent GraphItem="item" VisibilityList="VisibilityList" ToggleVisibility="ToggleVisibility"></GraphItemComponent>
        }
    </div>


}

@code {
    public HashSet<int> VisibilityList { get; set; } = new();

    private List<GraphItem> items { get; set; } = new List<GraphItem>();
    private bool isLoading { get; set; } = true;

    protected override void OnInitialized()
    {
        items = ItemRepo.GetSortedItems();
        isLoading = false;
    }

    public void ToggleVisibility(int id)
    {
        if (VisibilityList.Contains(id))
        {
            VisibilityList.Remove(id);
        }
        else
        {
            VisibilityList.Add(id);
        }
    }
}
